<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogNewGroupRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvNewGroupHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New tab group"
        android:textColor="#1F1F1F"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle description -->
    <TextView
        android:id="@+id/tvNewGroupSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your tab groups automatically save and update across all your signed-in devices"
        android:textColor="#5F6368"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp" />

    <!-- Title Label -->
    <TextView
        android:id="@+id/tvGroupTitleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textColor="#1A73E8"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Group Title Input -->
    <EditText
        android:id="@+id/etGroupTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="24dp"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:text="2 tabs"
        android:textColor="#1F1F1F"
        android:textSize="16sp"
        android:backgroundTint="#1A73E8" />

    <!-- Color Palette Container (Row 1: 5 dots, Row 2: 4 dots) -->
    <LinearLayout
        android:id="@+id/layoutColorPaletteRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:id="@+id/layoutColorPaletteRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnGroupCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Cancel"
            android:textColor="#5F6368"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnGroupDone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_pill_accent" />
    </LinearLayout>

</LinearLayout>
