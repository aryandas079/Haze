<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Group Header Area -->
    <LinearLayout
        android:id="@+id/groupHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <View
            android:id="@+id/groupColorBox"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#FF0000" />

        <TextView
            android:id="@+id/groupNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Group Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:id="@+id/groupCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="(1 tab)"
            android:textSize="12sp"
            android:textColor="#5F6368" />

        <TextView
            android:id="@+id/groupSummaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textSize="11sp"
            android:textColor="#5F6368"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/groupChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="Collapse or Expand Group" />

        <ImageView
            android:id="@+id/btnGroupMore"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Group Options" />
    </LinearLayout>

    <!-- Main Tab Row -->
    <LinearLayout
        android:id="@+id/tabRowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/rowTabSelectCheckbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_check"
            android:background="@drawable/bg_circle_icon_container"
            android:padding="4dp"
            android:visibility="gone"
            android:contentDescription="Select Tab" />

        <View
            android:id="@+id/groupSideIndicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="#FF0000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tabIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_globe"
            android:contentDescription="Tab Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="New Tab"
                android:textColor="#202124"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tabUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="haze://home"
                android:textColor="#5F6368"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTabRowThumbnail"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F3F5">

            <ImageView
                android:id="@+id/tabRowThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Thumbnail Preview" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/tabPinIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_pin"
            android:visibility="gone"
            android:contentDescription="Pinned Tab" />

        <ImageButton
            android:id="@+id/tabClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close Tab" />
    </LinearLayout>
</LinearLayout>