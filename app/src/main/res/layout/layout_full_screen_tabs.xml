<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabsRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFD">

    <!-- Top Navigation Bar (Chrome Style) -->
    <RelativeLayout
        android:id="@+id/topTabsNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <!-- Left: Blue Curved Squircle New Tab Button (+) -->
        <FrameLayout
            android:id="@+id/btnNewTabSquircle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_new_tab_squircle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF"
                android:contentDescription="New Tab" />
        </FrameLayout>

        <!-- Center: Connected Chrome Pill Segment [ 1 ] [ 🕶 ] -->
        <LinearLayout
            android:id="@+id/chromeSegmentedPill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_chrome_tab_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="3dp">

            <!-- Personal Tab Switcher Box [ 1 ] -->
            <FrameLayout
                android:id="@+id/btnTogglePersonal"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_tab_pill_active"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTabCountPill"
                    android:layout_width="22dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:background="@drawable/bg_tab_box"
                    android:text="1"
                    android:textColor="#202124"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Private / Incognito Switcher Box [ 🕶 ] -->
            <FrameLayout
                android:id="@+id/btnTogglePrivate"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivPrivatePillIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_incognito_chrome"
                    app:tint="#5F6368"
                    android:contentDescription="Private Tabs" />
            </FrameLayout>
        </LinearLayout>

        <!-- Right Side: View Mode & Three-Dots Menu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSelectTabs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Select Tabs"
                android:src="@drawable/ic_select_mode"
                app:tint="#444746" />

            <ImageButton
                android:id="@+id/btnToggleViewMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle View Mode"
                android:src="@drawable/ic_grid"
                app:tint="#444746" />

            <ImageButton
                android:id="@+id/btnRecentlyClosedTabs"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnTabsMoreOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tab Options"
                android:src="@drawable/ic_more_vert"
                app:tint="#1F1F1F" />

            <ImageButton
                android:id="@+id/btnCloseTabs"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Multi-selection Action Bar (shown when selecting tabs) -->
    <LinearLayout
        android:id="@+id/barMultiSelect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#E8EEF9"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnMultiSelectAll"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="#0B57D0"
            android:contentDescription="Select All" />

        <TextView
            android:id="@+id/tvMultiSelectCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="0 selected"
            android:textColor="#0B57D0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMultiSelectGroup"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tab_group"
            app:tint="#0B57D0"
            android:contentDescription="Group Selected" />

        <ImageButton
            android:id="@+id/btnMultiSelectClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="#B3261E"
            android:contentDescription="Close Selected" />

        <TextView
            android:id="@+id/btnMultiSelectDone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Done"
            android:textColor="#0B57D0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Chrome Full-Width Curved Search Bar: "Search your tabs" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/searchPillContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_chrome_search_pill"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etTabSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search your tabs"
                android:textColorHint="#5F6368"
                android:textSize="15sp"
                android:textColor="#202124"
                android:singleLine="true"
                android:imeOptions="actionDone"/>

            <ImageButton
                android:id="@+id/btnClearTabSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#5F6368"
                android:visibility="gone"
                android:contentDescription="Clear Search" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden compatibility text views for existing references -->
    <TextView
        android:id="@+id/tvTabsManagerHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCurrentModeLabel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnNewTabAction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Container for Tabs Grid & Incognito Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- RecyclerView for Tabs Grid (Curved Chrome Cards) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActiveTabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"/>

        <!-- Chrome Incognito Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyIncognito"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_incognito_chrome"
                app:tint="#9AA0A6"
                android:layout_marginBottom="16dp"
                android:contentDescription="Incognito Mode" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No open Incognito tabs"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tabs you open in Incognito won't be saved in your browsing history."
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/btnEmptyNewIncognito"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_new_tab_squircle"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="+ Open Incognito Tab"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Incognito Locked State Screen -->
        <LinearLayout
            android:id="@+id/layoutLockedIncognito"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_lock_shield"
                app:tint="#A8C7FA"
                android:layout_marginBottom="18dp"
                android:contentDescription="Locked Incognito" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Browsing is Locked"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlock with PIN or biometric authentication to view your open Incognito tabs."
                android:textColor="#9AA0A6"
                android:textSize="13.5sp"
                android:gravity="center"
                android:layout_marginBottom="28dp" />

            <TextView
                android:id="@+id/btnUnlockIncognito"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_new_tab_squircle"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Unlock Incognito"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>