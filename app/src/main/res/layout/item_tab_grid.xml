<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTabGrid"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="26dp"
    app:cardElevation="2dp"
    app:strokeWidth="2dp"
    app:strokeColor="#E2E7ED"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header inside Card (Chrome Style from Image 4) -->
        <LinearLayout
            android:id="@+id/gridHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@android:color/transparent">

            <FrameLayout
                android:id="@+id/gridTabIconContainer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_circle_icon_container">

                <ImageView
                    android:id="@+id/gridTabIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_globe"
                    android:contentDescription="Favicon" />
            </FrameLayout>

            <TextView
                android:id="@+id/gridTabTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tab Title"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#202124" />

            <ImageView
                android:id="@+id/gridTabPinIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                android:contentDescription="Pinned" />

            <ImageView
                android:id="@+id/gridTabSelectCheckbox"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_check"
                android:background="@drawable/bg_circle_icon_container"
                android:padding="4dp"
                android:visibility="gone"
                android:contentDescription="Select Tab" />

            <ImageButton
                android:id="@+id/gridTabClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:padding="5dp"
                app:tint="#5F6368"
                android:contentDescription="Close Tab" />
        </LinearLayout>

        <!-- Tab Thumbnail Preview Area with Inner Rounded Curves -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="4.5dp"
            android:layout_marginBottom="4.5dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8FAFD">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/gridTabThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Thumbnail Preview" />

                <TextView
                    android:id="@+id/gridTabUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#99000000"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:text="haze://home"
                    android:visibility="gone" />

                <View
                    android:id="@+id/gridGroupIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="top"
                    android:background="#0B57D0"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
