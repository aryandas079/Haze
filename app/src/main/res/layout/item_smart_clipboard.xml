<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSmartClipboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:background="@drawable/bg_clipboard_card"
    android:padding="16dp"
    android:elevation="1.5dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Header: Badge & Dismiss (Image 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ivClipboardBadgeIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_call"
            app:tint="#E53935"
            android:contentDescription="Clipboard Badge" />

        <TextView
            android:id="@+id/tvClipboardBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="COPIED NUMBER"
            android:textColor="#E53935"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/btnCloseClipboard"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="#74777F"
            android:padding="4dp"
            android:contentDescription="Dismiss" />
    </LinearLayout>

    <!-- Main Content Row -->
    <LinearLayout
        android:id="@+id/rowClipboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivClipboardTypeIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_call"
            app:tint="#E53935"
            android:contentDescription="Type" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClipboardAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Call or Search: 9435885077"
                android:textColor="#1F1F1F"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvClipboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Copied phone number"
                android:textColor="#5F6368"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivClipboardActionArrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_open_in_new"
            app:tint="#E53935"
            android:contentDescription="Action" />
    </LinearLayout>

    <!-- Chrome Style Rounded Pill Action Buttons (Image 1) -->
    <LinearLayout
        android:id="@+id/layoutNumberActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnClipCall"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_suggestion_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="📞 Call Number"
            android:textColor="#0B57D0"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnClipSearch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_suggestion_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🔍 Search Web"
            android:textColor="#1F1F1F"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
