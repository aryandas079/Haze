<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSmartClipboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:elevation="3dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Soft Circular Icon Badge -->
    <FrameLayout
        android:id="@+id/iconBadgeClipboard"
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageView
            android:id="@+id/ivClipboardTypeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_search"
            android:contentDescription="Clipboard Icon" />
    </FrameLayout>

    <!-- Content (Title & Preview Text) -->
    <LinearLayout
        android:id="@+id/rowClipboardContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvClipboardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text you copied"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvClipboardAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:text="Search: snippet"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Paste to bar quick button -->
    <ImageButton
        android:id="@+id/btnClipPaste"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_content_paste"
        android:padding="7dp"
        android:contentDescription="Paste in search bar" />

    <!-- Dismiss 'X' button -->
    <ImageButton
        android:id="@+id/btnCloseClipboard"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:padding="8dp"
        android:contentDescription="Dismiss" />

</LinearLayout>
