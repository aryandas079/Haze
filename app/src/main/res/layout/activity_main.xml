<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/appBackgroundImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="Background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/appBackgroundOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/findBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mini Player Container -->
    <include layout="@layout/layout_mini_player" />

    <!-- Fullscreen Video Container for HTML5 Video & Custom Views -->
    <FrameLayout
        android:id="@+id/fullscreenVideoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        android:elevation="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top-Left Floating Navigation Capsule (Back & Forward buttons while browsing) -->
    <LinearLayout
        android:id="@+id/floatingNavContainer"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="28dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/bg_floating_nav_pill"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Floating Back Button -->
        <FrameLayout
            android:id="@+id/btnFloatingBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Navigate Back">

            <ImageView
                android:id="@+id/ivFloatingBackIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#202124"
                android:contentDescription="Navigate Back" />
        </FrameLayout>

        <!-- Subtle Vertical Divider -->
        <View
            android:id="@+id/floatingNavDivider"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="#DADCE0" />

        <!-- Floating Forward Button -->
        <FrameLayout
            android:id="@+id/btnFloatingForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Navigate Forward">

            <ImageView
                android:id="@+id/ivFloatingForwardIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#202124"
                android:contentDescription="Navigate Forward" />
        </FrameLayout>
    </LinearLayout>

    <!-- Top-Right Actions on Home Screen (Privacy Shield + Profile) -->
    <LinearLayout
        android:id="@+id/topRightActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:elevation="28dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Circular Privacy Shield (i) Button -->
        <FrameLayout
            android:id="@+id/btnPrivacyShield"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_circle_gray">

            <ImageView
                android:id="@+id/ivPrivacyShieldIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_privacy_shield"
                android:contentDescription="Privacy Shield Dashboard" />

            <!-- Notification / Active indicator dot -->
            <View
                android:id="@+id/shieldBadgeDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_badge_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Circular Profile Button -->
        <FrameLayout
            android:id="@+id/btnProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_circle_gray">

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                android:contentDescription="Google Account Profile" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dim Overlay for Search Active State -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Recent Searches Panel -->
    <LinearLayout
        android:id="@+id/recentSearchesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_popup_rounded"
        android:elevation="24dp"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/addressBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvRecentHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Searches"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#5F6368"/>

            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Clear All"
                android:textSize="12sp"
                android:textColor="#0A56D0"
                android:textStyle="bold"
                android:padding="2dp"
                android:background="?attr/selectableItemBackground"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/recentSearchesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Find in Page Bar -->
    <LinearLayout
        android:id="@+id/findBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/addressBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar"
            android:hint="Find in page..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:textColor="#202124"
            android:textSize="14sp"/>

        <ImageButton
            android:id="@+id/btnFindPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_up"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/btnFindNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="Next" />

        <ImageButton
            android:id="@+id/btnFindClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close Find" />
    </LinearLayout>

    <!-- Address Bar Container at bottom of screen -->
    <FrameLayout
        android:id="@+id/addressBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:elevation="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Search Bar Pill (Zero Elevation for Flat Shadowless Look) -->
        <LinearLayout
            android:id="@+id/addressBarInner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_address_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:elevation="0dp">

            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search Icon"
                app:tint="#5F6368" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:textColor="#202124"
                android:textColorHint="#5F6368"
                android:textSize="15sp" />

            <!-- Clear Query Button (Hidden when empty) -->
            <ImageButton
                android:id="@+id/btnClearQuery"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                android:layout_marginEnd="4dp"
                android:contentDescription="Clear Text"
                app:tint="#5F6368" />

            <!-- Voice Search Button -->
            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic"
                android:layout_marginEnd="6dp"
                android:contentDescription="Voice Search"
                app:tint="#5F6368" />

            <!-- Tab Count / Manager Circular Button -->
            <FrameLayout
                android:id="@+id/btnTabsCircular"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tabCountBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#202124"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Dropdown Menu Button -->
            <ImageButton
                android:id="@+id/menuBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_wide_arrow_down"
                android:contentDescription="Menu"
                app:tint="#5F6368" />

        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>