<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardGroupContainer"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#0B57D0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Group Card Header (Matching Image 1) -->
        <LinearLayout
            android:id="@+id/groupCardHeader"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <!-- Circle Color Dot with outer concentric ring -->
            <FrameLayout
                android:id="@+id/flGroupColorDot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp">

                <View
                    android:id="@+id/vGroupColorOuterRing"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_circle_icon_container" />

                <View
                    android:id="@+id/vGroupColorInnerDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_icon_container" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvGroupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2 tabs"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnGroupMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="#FFFFFF"
                android:contentDescription="Group options" />
        </LinearLayout>

        <!-- 2x2 Mini-Grid for Member Tab Previews (Matching Image 1) -->
        <GridLayout
            android:id="@+id/gridMiniThumbnails"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="false">

            <!-- Slot 0: Top-Left -->
            <FrameLayout
                android:id="@+id/slot0Container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/miniCard0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFD">

                    <ImageView
                        android:id="@+id/miniThumb0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Tab preview" />

                    <!-- Mini Favicon Chip Container -->
                    <FrameLayout
                        android:id="@+id/chipFavicon0"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_circle_icon_container">

                        <ImageView
                            android:id="@+id/miniFavicon0"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_globe"
                            android:contentDescription="Favicon" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:id="@+id/placeholder0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Slot 1: Top-Right -->
            <FrameLayout
                android:id="@+id/slot1Container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/miniCard1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFD">

                    <ImageView
                        android:id="@+id/miniThumb1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Tab preview" />

                    <FrameLayout
                        android:id="@+id/chipFavicon1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_circle_icon_container">

                        <ImageView
                            android:id="@+id/miniFavicon1"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_globe"
                            android:contentDescription="Favicon" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:id="@+id/placeholder1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Slot 2: Bottom-Left -->
            <FrameLayout
                android:id="@+id/slot2Container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/miniCard2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFD">

                    <ImageView
                        android:id="@+id/miniThumb2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Tab preview" />

                    <FrameLayout
                        android:id="@+id/chipFavicon2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_circle_icon_container">

                        <ImageView
                            android:id="@+id/miniFavicon2"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_globe"
                            android:contentDescription="Favicon" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:id="@+id/placeholder2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Slot 3: Bottom-Right -->
            <FrameLayout
                android:id="@+id/slot3Container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/miniCard3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFD">

                    <ImageView
                        android:id="@+id/miniThumb3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Tab preview" />

                    <FrameLayout
                        android:id="@+id/chipFavicon3"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_circle_icon_container">

                        <ImageView
                            android:id="@+id/miniFavicon3"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_globe"
                            android:contentDescription="Favicon" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:id="@+id/placeholder3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

        </GridLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
